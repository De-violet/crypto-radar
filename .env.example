# ══════════════════════════════════════════════
# CRYPTO RADAR v7.0 — Environment Variables Template
# ══════════════════════════════════════════════
# Copy file ini ke `.env` dan isi dengan token asli kamu.
# JANGAN PERNAH commit file `.env` ke git!
#
# Mode Telegram sudah dihapus di v7.0. Kalau butuh mode Telegram,
# gunakan branch `legacy-telegram` atau tag `v6.0-telegram-final`.
# ══════════════════════════════════════════════

# ───────────────────────────────────────────────
# DISCORD TOKENS (wajib untuk Discord bot mode)
# ───────────────────────────────────────────────
# Dapatkan dari: https://discord.com/developers/applications → pilih bot → tab "Bot" → "Reset Token"
DISCORD_TOKEN=""

# Channel ID Discord untuk broadcast berita crypto
# Dapatkan dari: klik kanan channel → Copy Channel ID (butuh Developer Mode)
DISCORD_NEWS_CHANNEL_ID=""

# Channel ID Discord untuk alert listing Binance baru
DISCORD_ALERT_CHANNEL_ID=""

# ───────────────────────────────────────────────
# SUPABASE (wajib untuk Web dashboard & auth)
# ───────────────────────────────────────────────
# Dapatkan dari: https://supabase.com → project kamu → Settings → API
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ───────────────────────────────────────────────
# API SERVER (FastAPI di HuggingFace Spaces)
# ───────────────────────────────────────────────
# CORS origins yang diizinkan (comma-separated). Default: Vercel domain + localhost
# Ganti https://your-username-crypto-radar.hf.space dengan URL HF Space Anda
API_CORS_ORIGINS="https://your-username-crypto-radar.hf.space,https://your-domain.com,http://localhost:3000"

# API token untuk endpoint yang butuh auth (generate random string)
# Generate dengan: openssl rand -hex 32
# Kalau kosong, endpoint /api/v1/scan bisa diakses publik (mode dev)
API_INTERNAL_TOKEN=""

# ───────────────────────────────────────────────
# SCANNER SETTINGS (opsional, ada default)
# ───────────────────────────────────────────────
# Jumlah top coin USDT yang discan (by 24h quote volume)
SCAN_LIMIT=120

# Volume spike threshold (candle terakhir harus >= threshold x rata-rata 20 candle)
# Default 1.5 (naikkan ke 2.0 untuk lebih selektif)
VOL_SPIKE_THRESHOLD=1.5

# Threshold oversold Stochastic %K
STOCH_OVERSOLD=20

# Cooldown anti-spam per coin (jam)
COOLDOWN_HOURS=4

# ───────────────────────────────────────────────
# STRATEGY SELECTION (opsional)
# ───────────────────────────────────────────────
# Pilih strategi yang aktif (comma-separated). Kosongkan = semua aktif.
# Pilihan: reversal, breakout, trend_follow
STRATEGIES=""

# ───────────────────────────────────────────────
# HUGGINGFACE SPACES (di-set di Space Settings → Repository secrets)
# ───────────────────────────────────────────────
# Port di-fix 7860 oleh HF Spaces runtime — JANGAN ubah
# PORT=7860  # otomatis dari Dockerfile

# Untuk auto-deploy dari GitHub ke HF, set 2 secrets di repo GitHub Anda:
#   HF_TOKEN       = token dari https://huggingface.co/settings/tokens (scope: write)
#   HF_USERNAME    = username HF Anda (case-sensitive)
# Lalu workflow .github/workflows/hf-sync.yml akan auto-sync push main → HF Space
