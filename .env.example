# Public API base URL for the Python FastAPI backend
# Used by client-side fetches (none yet in Phase 0, but declared for Phase 1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side API base URL (used in /api/health route, falls back to NEXT_PUBLIC_API_BASE_URL)
# Optional - only needed if backend differs between client/server
# API_BASE_URL=http://localhost:8000
