# ══════════════════════════════════════════════
# CRYPTO RADAR v8.0 — Environment Variables Template
# ══════════════════════════════════════════════
# Salin file ini menjadi `.env` dan sesuaikan dengan konfigurasi Anda.
# JANGAN PERNAH meng-commit file `.env` ke git repository!
# ══════════════════════════════════════════════

# ───────────────────────────────────────────────
# TELEGRAM BOT CONFIGURATION (Wajib untuk Alert)
# ───────────────────────────────────────────────
# Token bot Telegram dari @BotFather (format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# Chat ID tujuan pengiriman alert (ID pengguna pribadi, grup, atau channel)
# Contoh User / Group: "123456789" atau "-1001234567890"
# Contoh Channel Publik: "@nama_channel_anda"
# Tips: Kirim pesan ke bot Anda, lalu cek ID via @userinfobot atau https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID="your_chat_id_here"

# ID Topik / Forum thread pada Telegram Supergroup (Opsional)
# Kosongkan jika grup biasa, channel, atau chat personal
TELEGRAM_THREAD_ID=""

# ───────────────────────────────────────────────
# SCANNER SETTINGS (Opsional — memiliki nilai default)
# ───────────────────────────────────────────────
# Jumlah koin USDT paling likuid dari Binance yang dipindai (berdasarkan 24h volume)
# Default: 100
SCAN_LIMIT=100

# Interval scanner otomatis di latar belakang dalam hitungan menit
# Default: 15 (setiap 15 menit)
SCAN_INTERVAL_MINUTES=15

# Ambang batas lonjakan volume (Volume candle terakhir >= threshold x rata-rata 20 candle)
# Default: 1.5 (naikkan ke 2.0 untuk filter yang lebih ketat)
VOL_SPIKE_THRESHOLD=1.5

# Batas oversold osilator Stochastic %K pada timeframe 1H
# Default: 20
STOCH_OVERSOLD=20

# Durasi jeda anti-spam (cooldown) dalam jam agar koin yang sama tidak di-spam
# Default: 4.0 (4 jam)
COOLDOWN_HOURS=4.0

# ───────────────────────────────────────────────
# STRATEGI AKTIF (Opsional)
# ───────────────────────────────────────────────
# Tentukan strategi apa saja yang aktif (dipisah tanda koma).
# Kosongkan untuk mengaktifkan seluruh strategi yang terdaftar.
# Pilihan: reversal, breakout, trend_follow
# Contoh: STRATEGIES="reversal,breakout"
STRATEGIES=""

# Lokasi penyimpanan file memori anti-spam
# Default: alerted_coins.json
MEMORY_FILE="alerted_coins.json"
