# ══════════════════════════════════════════════
# Crypto Radar v7.0 — .dockerignore
# ══════════════════════════════════════════════

# ── Secrets ──
.env
.env.local
.env.*.local
*.pem
*.key

# ── Python caches & build artifacts ──
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.Python
build/
dist/
.eggs/
.installed.cfg

# ── Virtualenvs ──
venv/
.venv/
env/
ENV/

# ── Test & CI artifacts ──
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
tests/

# ── Editor & OS ──
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Git & GitHub ──
.git/
.github/
.gitignore
.gitattributes

# ── Runtime memory (akan dibuat saat container jalan) ──
alerted_coins.json
posted_news.json
posted_listings.json
data/

# ── Backtest output ──
backtest_reports/

# ── Logs ──
*.log
logs/

# ── Docs (tidak perlu di image runtime) ──
README.md
CHANGELOG.md
CONTRIBUTING.md
LICENSE

# ── Dev configs ──
requirements-dev.txt

# ── Next.js web (branch `web`, deploy terpisah di Vercel) ──
apps/web/
web/
next/
.next/
node_modules/
